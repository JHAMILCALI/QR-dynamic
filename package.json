{
  "name": "qr-dinamicos",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "worker:deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 execute qr-dinamicos-db --local --file=./migrations/0001_init.sql",
